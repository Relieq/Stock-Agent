# Chép thành .env rồi sửa nếu cần. Không đưa .env lên GitHub.
DATABASE_URL=postgresql://soi:soi@localhost:5433/soi

# Thư mục lưu file tải về (tương đối so với thư mục Code/)
RAW_DATA_DIR=../Data/raw

# Mô hình đọc ảnh BCTC (giao diện kiểu OpenAI). Bắt buộc chọn, không có mặc định.
# LLM_PROVIDER: gemini / openai / openrouter / ollama / custom
LLM_PROVIDER=
# Chỉ điền key của nhà cung cấp đã chọn
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Xem danh sách mô hình dùng được: python -m services.llm
LLM_MODEL=
